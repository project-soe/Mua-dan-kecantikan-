PORT=3000

# Firebase target project
FIREBASE_PROJECT_ID=mua-and-beauty
# Path ke service account JSON di server backend saja; jangan commit file JSON.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Origin frontend produksi, pisahkan beberapa origin dengan koma.
ALLOWED_ORIGINS=https://mua-putri.id,https://www.mua-putri.id

# ImageKit. Private key hanya di environment backend/secret manager.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Opsional: hanya untuk emulator lokal.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

