{
  "name": "mua-putri-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "emulators": "bash scripts/dev-emulators.sh",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-mua-putri \"node --test --test-concurrency=1 tests/security/*.test.js\"",
    "start": "node backend/src/server.js",
    "test:integration": "IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/test firebase emulators:exec --only auth,firestore,storage --project demo-mua-putri \"node --test --test-concurrency=1 tests/integration/*.test.js\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:integration",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/seed.js",
    "dev:backend": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node backend/src/server.js",
    "check:frontend": "node scripts/check-frontend.js",
    "dev:payments": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/dev-payments.js",
    "emulators:fresh": "firebase emulators:start --project demo-mua-putri"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0"
  }
}
