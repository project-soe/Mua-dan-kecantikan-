rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function mPath(t) {
      return /databases/(default)/documents/tenants/$(t)/memberships/$(request.auth.uid);
    }
    function isActiveMember(t) {
      return verified() && firestore.exists(mPath(t))
        && firestore.get(mPath(t)).data.status == 'active';
    }
    function hasRole(t, roles) {
      return isActiveMember(t) && firestore.get(mPath(t)).data.role in roles;
    }
    function canWriteMedia(t) { return hasRole(t, ['owner', 'admin', 'content_manager']); }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp|avif)'); }
    function maxMb(mb) { return request.resource.size <= mb * 1024 * 1024; }

    match /tenants/{t} {
      // Media publik: boleh diunduh, tetapi listing direktori tidak dibuka.
      // Upload memakai path unik; file yang sudah ada tidak boleh ditimpa.
      match /branding/{file=**} {
        allow get: if true;
        allow create: if canWriteMedia(t) && isImage() && maxMb(2);
      }
      match /services/{file=**} {
        allow get: if true;
        allow create: if canWriteMedia(t) && isImage() && maxMb(8);
      }
      match /promotions/{file=**} {
        allow get: if true;
        allow create: if canWriteMedia(t) && isImage() && maxMb(8);
      }
      match /portfolio/thumbnails/{file=**} {
        allow get: if true;
        allow create: if canWriteMedia(t) && isImage() && maxMb(12);
      }
      match /portfolio/optimized/{file=**} {
        allow get: if true;
        allow create: if canWriteMedia(t) && isImage() && maxMb(12);
      }
      match /products/thumbnails/{file=**} {
        allow get: if true;
        allow create: if canWriteMedia(t) && isImage() && maxMb(8);
      }
      match /products/optimized/{file=**} {
        allow get: if true;
        allow create: if canWriteMedia(t) && isImage() && maxMb(8);
      }

      // Foto klien pada testimoni: publik dapat mengunduh, staf konten dapat mengunggah.
      match /reviews/{file=**} {
        allow get: if true;
        allow create: if canWriteMedia(t) && isImage() && maxMb(4);
      }

      // QRIS sengaja dapat diunduh publik; hanya owner/finance yang dapat mengunggah.
      match /payment-methods/{file=**} {
        allow get: if true;
        allow create: if hasRole(t, ['owner', 'finance_manager']) && isImage() && maxMb(2);
      }

      // Original resolusi tinggi: hanya staf tenant yang dapat mengunduh atau mengunggah.
      match /portfolio/originals/{file=**} {
        allow get: if canWriteMedia(t);
        allow create: if canWriteMedia(t) && isImage() && maxMb(12);
      }
      match /products/originals/{file=**} {
        allow get: if canWriteMedia(t);
        allow create: if canWriteMedia(t) && isImage() && maxMb(8);
      }

      // Privat: bukti bayar. Pelanggan hanya dapat mengunduh miliknya sendiri;
      // owner/finance dapat mengunduh bukti tenant. File tidak dapat ditimpa.
      match /payment-proofs/{uid}/{file=**} {
        allow get: if signedIn()
          && (request.auth.uid == uid || hasRole(t, ['owner', 'finance_manager']));
        allow create: if signedIn() && request.auth.uid == uid && isImage() && maxMb(5) && resource == null;
      }
      match /customer-uploads/{uid}/{file=**} {
        allow get: if signedIn()
          && (request.auth.uid == uid || hasRole(t, ['owner', 'admin']));
        allow create: if signedIn() && request.auth.uid == uid && isImage() && maxMb(5) && resource == null;
      }
    }
    // Selain itu: default deny (termasuk semua delete dari klien dan listing).
  }
}
