rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function mPath(t) {
      return /databases/$(database)/documents/tenants/$(t)/memberships/$(request.auth.uid);
    }
    function isActiveMember(t) {
      return verified() && exists(mPath(t)) && get(mPath(t)).data.status == 'active';
    }
    function hasRole(t, roles) {
      return isActiveMember(t) && get(mPath(t)).data.role in roles;
    }
    function ownsDoc() { return signedIn() && resource.data.keys().hasAny(['customerId']) && resource.data.customerId == request.auth.uid; }
    function publishedOrMember(t) {
      return resource.data.published == true || isActiveMember(t);
    }

    // Read model publik
    match /publicTenants/{t} {
      allow read: if true;
      allow write: if false;
    }
    match /platformDomains/{d} {
      allow get: if resource.data.status == 'active';
      allow list, write: if false;
    }

    match /tenants/{t} {
      match /profile/{docId}  { allow read: if isActiveMember(t); allow write: if false; }
      match /branding/{docId} { allow read: if isActiveMember(t); allow write: if false; }

      match /settings/{docId} {
        allow read: if docId == 'paymentPrivate'
          ? hasRole(t, ['owner', 'finance_manager'])
          : isActiveMember(t);
        allow write: if false;
      }

      match /memberships/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || hasRole(t, ['owner', 'admin']));
        allow write: if false;
      }

      // Katalog: publik hanya yang published
      match /products/{id}   { allow read: if publishedOrMember(t); allow write: if false; }
      match /services/{id}   { allow read: if publishedOrMember(t); allow write: if false; }
      match /portfolio/{id}  { allow read: if publishedOrMember(t); allow write: if false; }
      match /promotions/{id} { allow read: if publishedOrMember(t); allow write: if false; }
      match /reviews/{id}    { allow read: if publishedOrMember(t); allow write: if false; }
      match /productCategories/{id} { allow read: if true; allow write: if false; }
      match /serviceCategories/{id} { allow read: if true; allow write: if false; }

      match /models/{id} { allow read: if isActiveMember(t); allow write: if false; }
      match /media/{id}  { allow read: if isActiveMember(t); allow write: if false; }

      // Transaksi: milik sendiri atau staf
      match /bookings/{id} {
        allow read: if ownsDoc() || hasRole(t, ['owner', 'admin', 'finance_manager']);
        allow write: if false;
      }
      match /orders/{id} {
        allow read: if ownsDoc() || hasRole(t, ['owner', 'admin', 'finance_manager']);
        allow write: if false;
      }
      match /shipments/{id} {
        allow read: if ownsDoc() || hasRole(t, ['owner', 'admin', 'finance_manager']);
        allow write: if false;
      }
      match /shippingQuotes/{id} {
        allow read: if ownsDoc() || hasRole(t, ['owner', 'admin']);
        allow write: if false;
      }
      match /payments/{id} {
        allow read: if ownsDoc() || hasRole(t, ['owner', 'finance_manager']);
        allow write: if false;
      }
      match /customers/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || hasRole(t, ['owner', 'admin', 'finance_manager']));
        allow write: if false;
      }
      match /addresses/{id} { allow read: if ownsDoc(); allow write: if false; }
      match /notifications/{id} {
        allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
        allow write: if false;
      }
      match /auditLogs/{id} { allow read: if hasRole(t, ['owner']); allow write: if false; }
      // bookingSlots, vouchers, idempotencyKeys, analytics: tidak ada akses klien (default deny)
    }
    // platformUsers, platformSettings, tenantInvitations: default deny
  }
}
